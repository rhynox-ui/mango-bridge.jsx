{
  "manifest_version": 3,
  "name": "Mango Wallet",
  "short_name": "Mango Wallet",
  "version": "0.2.1",
  "description": "Self-custodial EVM + Solana wallet for Mango Protocol. Your keys never leave this device.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "111",
  "permissions": ["storage", "windows", "scripting"],
  "host_permissions": ["<all_urls>"]
}

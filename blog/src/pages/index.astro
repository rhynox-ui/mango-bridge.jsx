---
// src/pages/index.astro
//
// Post listing — import.meta.glob (native Vite, stable across Astro
// versions) rather than the content-collections API, so adding a new
// post is just "drop a .md file in src/pages/blog/", no schema/config
// file to also update. eager: true resolves frontmatter synchronously
// at build time, which is all a static list needs.
import MangoLogo from "../components/MangoLogo.astro";

const posts = Object.values(import.meta.glob("./blog/*.md", { eager: true })) as {
  url: string;
  frontmatter: { title: string; description: string; date: string };
}[];
posts.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mango Protocol Blog</title>
    <meta name="description" content="Updates from Mango Protocol — the non-custodial cross-chain bridge and launchpad." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #ffffff;
        --panel-border: #e6e6e8;
        --text-primary: #0a0a0b;
        --text-secondary: #6b6b70;
        --text-muted: #a6a6ac;
        --lime: #ff9a2e;
        --lime-deep: #e8801a;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text-primary);
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--panel-border);
        padding: 18px 24px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--text-primary);
        text-decoration: none;
      }
      .brand-name {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: -0.01em;
      }
      .brand-badge {
        font-size: 10.5px;
        font-weight: 600;
        color: var(--lime-deep);
        background: rgba(255, 154, 46, 0.12);
        border-radius: 999px;
        padding: 3px 9px;
        letter-spacing: 0.02em;
      }
      main {
        max-width: 680px;
        margin: 0 auto;
        padding: 8px 24px 80px;
      }
      .intro {
        padding: 48px 0 36px;
        border-bottom: 1px solid var(--panel-border);
      }
      .intro h1 {
        font-family: "Space Grotesk", sans-serif;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin: 0 0 8px;
        text-wrap: balance;
      }
      .intro p {
        color: var(--text-secondary);
        font-size: 14.5px;
        margin: 0;
        max-width: 52ch;
      }
      .post-link {
        display: block;
        text-decoration: none;
        color: inherit;
        padding: 24px 0;
        border-bottom: 1px solid var(--panel-border);
        border-left: 2px solid transparent;
        padding-left: 14px;
        margin-left: -14px;
        transition: border-color 0.15s ease, background 0.15s ease;
      }
      .post-link:hover {
        border-left-color: var(--lime);
        background: rgba(255, 154, 46, 0.04);
      }
      .post-title {
        font-family: "Space Grotesk", sans-serif;
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 6px;
      }
      .post-desc {
        color: var(--text-secondary);
        font-size: 14px;
        margin: 0 0 8px;
      }
      .post-date {
        color: var(--text-muted);
        font-size: 12px;
      }
      footer {
        border-top: 1px solid var(--panel-border);
        padding: 28px 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        color: var(--text-muted);
        font-size: 12px;
      }
      footer a {
        color: var(--text-muted);
        text-decoration: none;
      }
      footer a:hover {
        color: var(--text-secondary);
      }
      .footer-social {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .footer-social a {
        display: flex;
      }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/">
        <MangoLogo size={22} color="#0A0A0B" />
        <span class="brand-name">Mango Protocol</span>
      </a>
      <span class="brand-badge">Blog</span>
    </header>
    <main>
      <div class="intro">
        <h1>Notes from the orchard</h1>
        <p>Product updates, launches, and the odd deep-dive — from the team building Mango Protocol.</p>
      </div>
      {
        posts.map((post) => (
          <a class="post-link" href={post.url}>
            <p class="post-title">{post.frontmatter.title}</p>
            <p class="post-desc">{post.frontmatter.description}</p>
            <p class="post-date">
              {new Date(post.frontmatter.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </p>
          </a>
        ))
      }
    </main>
    <footer>
      <a href="https://mangoprotocol.site">mangoprotocol.site</a>
      <div class="footer-social">
        <a href="https://x.com/Mango_protocol" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-6.8l-5.3-6.9L5 22H1.9l8.1-9.3L1 2h7l4.8 6.3L18.9 2Zm-1.2 18h1.9L7.4 4H5.4l12.3 16Z"></path></svg>
        </a>
        <a href="https://t.me/mango_protocol" aria-label="Telegram" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
        </a>
        <a href="mailto:mango@mangoprotocol.site" aria-label="Email">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
        </a>
      </div>
    </footer>
  </body>
</html>
